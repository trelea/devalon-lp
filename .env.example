# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the sender address (defaults to "Devalon <contact@devalon.dev>")
RESEND_FROM_EMAIL="Devalon <contact@devalon.dev>"

# Meta (Facebook) Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=1675347790668605
META_CAPI_ACCESS_TOKEN=your_meta_capi_access_token
META_TEST_EVENT_CODE=

# Google Tag Manager (GA4 is configured inside GTM)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX